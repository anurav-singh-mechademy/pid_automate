# Copy to deploy/config.env (git-ignored) and replace every <placeholder>. All deploy/ scripts read it.
# Account-specific values stay out of the repo on purpose.

# AWS CLI profile and region to deploy into. push.sh needs ECR rights; deploy.sh also needs S3, Lambda, and
# iam:CreateRole + iam:PassRole the first time (PowerUser-style roles usually lack the last two).
AWS_PROFILE="<aws-cli-profile>"
AWS_REGION="<aws-region>"

# Prefix for everything created: ECR repo <NAME>, bucket <NAME>-input-<account-id>, role <NAME>-lambda-role,
# functions <NAME>-detect and <NAME>-ocr.
NAME="<resource-name-prefix>"

# The fine-tuned RF-DETR weights (rfdetr_pid.pth) and their sha256. The build refuses a file with any other hash.
WEIGHTS_DIR="<folder-holding-rfdetr_pid.pth>"
WEIGHTS_SHA256="<sha256-of-rfdetr_pid.pth>"

# Optional: the one role from outside the account's own users allowed to upload pages and call the URLs,
# e.g. arn:aws:iam::<account-id>:role/<caller-role-name>. Leave empty for same-account users only.
CALLER_ROLE_ARN=

# test.sh only: a P&ID PDF and the 0-based page to test on.
SAMPLE_PDF="<path-to-a-pid-pdf>"
SAMPLE_PAGE="<page-index>"
